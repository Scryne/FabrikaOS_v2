# FabrikaOS ortam degiskenleri (ornek). Kopyala: cp .env.example .env
# NOT: .env asla commit edilmez (.gitignore'da).

# --- Uygulama ---
APP_ENV=dev                 # dev | staging | prod
APP_NAME=FabrikaOS
DEBUG=true
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
API_V1_PREFIX=/api/v1

# Uretimde MUTLAKA degistir (rastgele uzun bir deger):
SECRET_KEY=degistir-bu-degeri-uretimde-rastgele-uzun-bir-deger

# Virgulle degil JSON listesi olarak:
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Veritabani / Cache (S2+ sprintlerinde kullanilacak) ---
DATABASE_URL=postgresql+asyncpg://fabrikaos:fabrikaos@db:5432/fabrikaos
REDIS_URL=redis://redis:6379/0

# --- Nesne depolama (MinIO) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=fabrikaos
MINIO_SECRET_KEY=fabrikaos-minio-parola
MINIO_SECURE=false
MINIO_BUCKET=fabrikaos

# --- MQTT (saha) ---
MQTT_HOST=mqtt
MQTT_PORT=1883

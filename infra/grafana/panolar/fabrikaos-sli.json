{
  "uid": "fabrikaos-sli",
  "title": "FabrikaOS · SLI / SLO",
  "description": "S19 (ADR-0040): erişilebilirlik ve gecikme SLO'ları, hata bütçesi, işçi sağlığı, hata logları.",
  "tags": [
    "fabrikaos",
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Erişilebilirlik · 30 gün",
      "description": "SLO-1 (NFR-03): isteklerin ≥ %99,5'i 5xx olmadan döner.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (sum(increase(fabrikaos_http_istekleri_total{durum=~\"5..\",rota!~\"/saglik.*\"}[30d])) / clamp_min(sum(increase(fabrikaos_http_istekleri_total{rota!~\"/saglik.*\"}[30d])), 1e-9))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Kalan bütçe · 30 gün",
      "description": "Bütçe = %0,5 hata. 0'ın altı: SLO ihlal edildi, yeni özellik yerine güvenilirlik işi önce gelir.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - ((sum(increase(fabrikaos_http_istekleri_total{durum=~\"5..\",rota!~\"/saglik.*\"}[30d])) / clamp_min(sum(increase(fabrikaos_http_istekleri_total{rota!~\"/saglik.*\"}[30d])), 1e-9)) / 0.005)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "GET p95 · 5 dk",
      "description": "SLO-2 (NFR-01): p95 < 300 ms. Yoklama uçları hariç.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fabrikaos_http_istek_suresi_saniye_bucket{yontem=\"GET\",rota!~\"/saglik.*\"}[5m])))",
          "instant": true
